# Optional: seed the dev-helper backend's config at startup. If you leave
# these unset, start the server anyway and use the Flutter app's Config
# screen to POST your key to /api/configure at runtime instead — either
# path ends up in the same place (this process's memory, never on disk,
# never in the Flutter app).
# There is no hosted Swalvo Cloud for this repo. SWALVO_API_URL should
# point at your own running apps/api (NestJS) — http://localhost:4100 is
# that service's own default for local development (its API_PORT), so you
# can usually leave this unset entirely unless apps/api runs somewhere
# else for you (a different port, a deployed environment, etc.).
SWALVO_API_KEY=rvk_xxx.yyy
SWALVO_API_URL=http://localhost:4100
PORT=8792
