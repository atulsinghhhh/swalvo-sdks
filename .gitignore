# Environment
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
# Scratch build output used when verifying a running API against a
# separate process — never source, never shippable.
.verify-dist/
build/
.next/
*.tsbuildinfo

# Prisma client gets generated here on build, don't commit it
apps/api/src/generated/

# Python (sdks/python)
.venv/
__pycache__/
*.pyc
*.egg-info/
.mypy_cache/
.pytest_cache/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.claude/

# Docker
infrastructure/docker/**/*.local.*

# Local dev TLS cert (self-signed, generated by scripts/generate-turn-cert.sh —
# never commit certs/keys, even self-signed local-only ones)
infrastructure/docker/coturn/certs/

/.docs

# Dart/Flutter build output. `.dart_tool/` is a package cache full of
# absolute paths, so it is machine-specific and never portable.
# `pubspec.lock` is deliberately ignored too: every Dart package here is a
# *library*, and pub's own guidance is that libraries do not pin — an app
# that depends on raven_rtc resolves its own versions.
.dart_tool/
sdks/flutter/*/pubspec.lock

# Every Flutter example app's "Until the SDKs are published to pub.dev"
# override (see e.g. examples/flutter-sdk-test-app/README.md): a local,
# machine-specific `path:` override onto this working tree's own
# sdks/flutter/* packages (and, for flutter-sdk-test-app specifically, the
# vendored flutter_webrtc patch in third_party/). Committing one would
# silently force every contributor and CI run onto local path dependencies
# forever — including masking the day swalvo_rtc/swalvo_chat/swalvo_live
# are actually published and this override is no longer needed at all.
# Found genuinely present and about to be swept up by a bulk `git add` of
# examples/flutter-sdk-test-app during an audit — not a hypothetical.
examples/*/pubspec_overrides.yaml
sdks/flutter/*/pubspec_overrides.yaml

# Vercel CLI project links (per-project, machine-local)
.vercel

# NOTE: do not add a blanket `.env*` here. gitignore is last-match-wins, so
# a trailing `.env*` overrides the `!.env.example` negation at the top of
# this file and silently un-tracks the 89-variable template every developer
# copies to get started. The `.env` / `.env.*` pair up there already covers
# every real env file.

# Generated by scripts/docs-groundtruth.mjs on every docs build; never hand-edited.
apps/docs/groundtruth.json

# Live Streaming capacity rig (scripts/capacity). vendor/ is a staged copy
# of the published SDK builds, rebuilt from source on every run; results/
# is raw measurement output, one JSON file per run; .content/ is a
# generated Y4M capture loop, tens to hundreds of MB uncompressed. None of
# the three is source, and none is reproducible-by-diff — see
# scripts/capacity/README.md.
scripts/capacity/harness/vendor/
scripts/capacity/results/
scripts/capacity/.content/

# Egress worker's harness vendor/ — same story as scripts/capacity's above:
# a staged copy of the published SDK builds the browser harness imports,
# rebuilt from source via scripts/stage-harness-sdk.mjs, not source itself.
services/egress-worker/src/harness/vendor/

docs/architecture/HLD.md
docs/production/architecture-5k.md

/test
RAVEN_FLUTTER_E2E_REPORT.md
