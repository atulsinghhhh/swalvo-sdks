{
  "name": "@swalvo/react-native",
  "version": "0.1.0",
  "description": "Official React Native SDK for the Swalvo hosted platform — real-time video, voice, and messaging on iOS and Android with the same API as Swalvo Web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atulsinghhhh/swalvo-sdks.git",
    "directory": "packages/react-native-sdk"
  },
  "homepage": "https://github.com/atulsinghhhh/swalvo-sdks/tree/main/packages/react-native-sdk#readme",
  "bugs": {
    "url": "https://github.com/atulsinghhhh/swalvo-sdks/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "keywords": [
    "swalvo",
    "webrtc",
    "react-native",
    "video",
    "voice",
    "chat",
    "ios",
    "android"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/assert-publish-safe.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "@swalvo/chat": "*",
    "@swalvo/rtc": "*",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-incall-manager": ">=4.2.0",
    "react-native-webrtc": ">=124.0.0",
    "react-native-video": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@swalvo/chat": {
      "optional": true
    },
    "react-native-incall-manager": {
      "optional": true
    },
    "react-native-video": {
      "optional": true
    }
  },
  "devDependencies": {
    "@swalvo/chat": "workspace:*",
    "@swalvo/rtc": "workspace:*",
    "@react-native-community/netinfo": "^11.4.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "jest": "^29.7.0",
    "react": "^19.2.8",
    "react-native": "^0.87.1",
    "react-native-incall-manager": "^4.2.2",
    "react-native-webrtc": "^124.0.8",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "test",
    "testRegex": ".*\\.spec\\.tsx?$",
    "setupFiles": [
      "<rootDir>/setup.ts"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/mocks/react-native.ts",
      "^react-native-webrtc$": "<rootDir>/mocks/react-native-webrtc.ts",
      "^react-native-incall-manager$": "<rootDir>/mocks/react-native-incall-manager.ts"
    }
  }
}
