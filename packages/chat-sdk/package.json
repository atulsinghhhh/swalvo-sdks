{
  "name": "@swalvo/chat",
  "version": "0.1.1",
  "description": "Official browser SDK for real-time messaging on the Swalvo hosted platform — connect, send, and receive without writing a line of WebSocket code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atulsinghhhh/swalvo-sdks.git",
    "directory": "packages/chat-sdk"
  },
  "homepage": "https://github.com/atulsinghhhh/swalvo-sdks/tree/main/packages/chat-sdk#readme",
  "bugs": {
    "url": "https://github.com/atulsinghhhh/swalvo-sdks/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/assert-publish-safe.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.1",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "rootDir": "test",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/../src/$1"
    }
  },
  "keywords": [
    "swalvo",
    "chat",
    "messaging",
    "realtime",
    "websocket",
    "sdk"
  ]
}
