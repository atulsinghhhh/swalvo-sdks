{
  "name": "@swalvo/react",
  "version": "0.1.1",
  "description": "Official React SDK for the Swalvo hosted platform — hooks and optional UI primitives for @swalvo/rtc, headless by default, no UI lock-in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atulsinghhhh/swalvo-sdks.git",
    "directory": "packages/react-sdk"
  },
  "homepage": "https://github.com/atulsinghhhh/swalvo-sdks/tree/main/packages/react-sdk#readme",
  "bugs": {
    "url": "https://github.com/atulsinghhhh/swalvo-sdks/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js",
      "require": "./dist/chat.cjs"
    },
    "./chat/styles.css": "./dist/chat/styles.css",
    "./video/styles.css": "./dist/video/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/assert-publish-safe.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "@swalvo/chat": "*",
    "@swalvo/live": "*",
    "@swalvo/rtc": "*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@swalvo/chat": {
      "optional": true
    },
    "@swalvo/live": {
      "optional": true
    },
    "@swalvo/rtc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@swalvo/chat": "workspace:*",
    "@swalvo/live": "workspace:*",
    "@swalvo/rtc": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.2.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "rootDir": "test",
    "testRegex": ".*\\.spec\\.tsx?$",
    "setupFiles": [
      "<rootDir>/setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/setup-after-env.ts"
    ]
  },
  "keywords": [
    "swalvo",
    "react",
    "webrtc",
    "hooks",
    "video",
    "chat"
  ]
}
