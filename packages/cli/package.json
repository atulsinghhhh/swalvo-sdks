{
  "name": "@swalvo/cli",
  "version": "0.1.0",
  "description": "Official CLI for the Swalvo hosted platform — manage projects, API keys, and rooms from the terminal; wire up a local app for RTC development.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atulsinghhhh/swalvo-sdks.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/atulsinghhhh/swalvo-sdks/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/atulsinghhhh/swalvo-sdks/issues"
  },
  "type": "module",
  "bin": {
    "swalvo": "dist/index.js",
    "raven": "dist/raven.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/assert-publish-safe.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "open": "^11.0.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "test",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^chalk$": "<rootDir>/mocks/chalk.ts",
      "^open$": "<rootDir>/mocks/open.ts",
      "^@/(.*)\\.js$": "<rootDir>/../src/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "keywords": [
    "swalvo",
    "cli",
    "webrtc",
    "rtc",
    "chat",
    "live-streaming"
  ]
}
