{
  "description": "Livqeno data message v2 envelope vectors (docs/architecture/phase7-contracts.md §1.2-1.3). Every client SDK encodes and decodes these byte for byte. Hex is lowercase; strings are UTF-8 on the wire.",
  "format": {
    "encode": "0x52 0x02 | flags (1 byte, 0) | topicLen (1 byte) | topic | destCount (1 byte, 0-64) | destCount x (idLen (1 byte, 1-255) | identity) | payload",
    "decode": "0x52 0x03 | senderLen (1 byte) | sender | topicLen (1 byte) | topic | payload. Anything else, including a frame that is truncated or has invalid UTF-8, is a legacy message: the whole input is the payload, with no sender and no topic. senderIdentity \"\" means the server.",
    "limits": {
      "maxTopicBytes": 255,
      "maxDestinations": 64,
      "maxIdentityBytes": 255,
      "maxReliablePayloadBytes": 65536,
      "maxLossyPayloadBytes": 1200
    }
  },
  "encode": [
    {
      "name": "broadcast, no topic",
      "input": {
        "topic": "",
        "destinationIdentities": [],
        "payloadHex": "68656c6c6f"
      },
      "expectedHex": "520200000068656c6c6f"
    },
    {
      "name": "broadcast, empty payload",
      "input": {
        "topic": "",
        "destinationIdentities": [],
        "payloadHex": ""
      },
      "expectedHex": "5202000000"
    },
    {
      "name": "topic only",
      "input": {
        "topic": "chat",
        "destinationIdentities": [],
        "payloadHex": "68656c6c6f"
      },
      "expectedHex": "52020004636861740068656c6c6f"
    },
    {
      "name": "targeted, no topic",
      "input": {
        "topic": "",
        "destinationIdentities": [
          "alice",
          "bob"
        ],
        "payloadHex": "00ff52"
      },
      "expectedHex": "520200000205616c69636503626f6200ff52"
    },
    {
      "name": "topic and targeted",
      "input": {
        "topic": "cursor",
        "destinationIdentities": [
          "alice"
        ],
        "payloadHex": "68656c6c6f"
      },
      "expectedHex": "52020006637572736f720105616c69636568656c6c6f"
    },
    {
      "name": "unicode topic and identity",
      "input": {
        "topic": "chat/💬",
        "destinationIdentities": [
          "zoë",
          "佐藤"
        ],
        "payloadHex": "68c3a96c6c6f20e29c93"
      },
      "expectedHex": "52020009636861742ff09f92ac02047a6fc3ab06e4bd90e897a468c3a96c6c6f20e29c93"
    },
    {
      "name": "payload that itself starts with the magic bytes",
      "input": {
        "topic": "t",
        "destinationIdentities": [],
        "payloadHex": "520352"
      },
      "expectedHex": "520200017400520352"
    },
    {
