  "decode": [
    {
      "name": "from a participant, no topic",
      "inputHex": "520305616c6963650068656c6c6f",
      "expected": {
        "legacy": false,
        "senderIdentity": "alice",
        "topic": "",
        "payloadHex": "68656c6c6f"
      }
    },
    {
      "name": "from a participant, with topic",
      "inputHex": "520305616c696365046368617468656c6c6f",
      "expected": {
        "legacy": false,
        "senderIdentity": "alice",
        "topic": "chat",
        "payloadHex": "68656c6c6f"
      }
    },
    {
      "name": "server-originated (empty sender)",
      "inputHex": "5203000673797374656d7b226f6b223a747275657d",
      "expected": {
        "legacy": false,
        "senderIdentity": "",
        "topic": "system",
        "payloadHex": "7b226f6b223a747275657d"
      }
    },
    {
      "name": "server-originated, no topic, empty payload",
      "inputHex": "52030000",
      "expected": {
        "legacy": false,
        "senderIdentity": "",
        "topic": "",
        "payloadHex": ""
      }
    },
    {
      "name": "unicode sender and topic",
      "inputHex": "5203047a6fc3ab09636861742ff09f92ac68c3a96c6c6f20e29c93",
      "expected": {
        "legacy": false,
        "senderIdentity": "zoë",
        "topic": "chat/💬",
        "payloadHex": "68c3a96c6c6f20e29c93"
      }
    },
    {
      "name": "max sender and topic length",
      "inputHex": "",
      "expected": {
        "legacy": false,
        "senderIdentity": "iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii",
        "topic": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "payloadHex": "01"
      }
    },
    {
      "name": "payload that itself starts with the magic bytes",
      "inputHex": "520303626f620052035202",
      "expected": {
        "legacy": false,
        "senderIdentity": "bob",
        "topic": "",
        "payloadHex": "52035202"
      }
    },
    {
      "name": "legacy message (no magic)",
      "inputHex": "68656c6c6f",
      "expected": {
        "legacy": true,
        "senderIdentity": null,
        "topic": null,
        "payloadHex": "68656c6c6f"
      }
    },
    {
      "name": "legacy empty message",
      "inputHex": "",
      "expected": {
        "legacy": true,
        "senderIdentity": null,
        "topic": null,
        "payloadHex": ""
      }
    },
    {
      "name": "legacy single 0x52 byte",
      "inputHex": "52",
      "expected": {
        "legacy": true,
        "senderIdentity": null,
        "topic": null,
        "payloadHex": "52"
      }
    },
    {
      "name": "client envelope (0x52 0x02) is not a delivery frame: legacy",
      "inputHex": "520200000068",
      "expected": {
        "legacy": true,
        "senderIdentity": null,
        "topic": null,
        "payloadHex": "520200000068"
      }
    },
    {
      "name": "truncated: sender length past end: legacy",
      "inputHex": "52030561",
      "expected": {
        "legacy": true,
        "senderIdentity": null,
        "topic": null,
        "payloadHex": "52030561"
      }
    },
    {
      "name": "truncated: missing topic length: legacy",
      "inputHex": "52030161",
      "expected": {
        "legacy": true,
        "senderIdentity": null,
        "topic": null,
        "payloadHex": "52030161"
      }
    },
    {
